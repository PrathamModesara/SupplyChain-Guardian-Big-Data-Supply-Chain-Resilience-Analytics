# ============================================================
# SupplyChain Guardian - Git Ignore
# ============================================================

# Scala / Spark compiled files
*.class
*.jar

# Build directories
build/
classes/
target/

# Spark temporary files
.sparkStaging/
spark-warehouse/

# Python cache
__pycache__/
*.pyc

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Large datasets
*.csv
*.xlsx
*.zip

# Local environment
.env
venv/
.venv/

# Hadoop / Spark local outputs
tmp/
